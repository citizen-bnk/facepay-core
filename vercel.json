{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "includeFiles": "{drizzle/**,src/api/docs-assets/**}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "crons": [
    {
      "path": "/mobile/retention",
      "schedule": "0 2 * * *"
    }
  ]
}
